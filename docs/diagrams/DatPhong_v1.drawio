        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n  subgraph TEN[\&quot;Tenant\&quot;]\n    Start((\&quot; \&quot;))\n    T1([\&quot;Select ROOMS and expected move-in date\&quot;])\n    T2([\&quot;Submit booking request\&quot;])\n    T3([\&quot;Review booking terms\&quot;])\n    T4{\&quot;Accept terms?\&quot;}\n    T5([\&quot;Pay holding deposit (online or bank transfer)\&quot;])\n    T6([\&quot;Receive booking confirmation\&quot;])\n  end\n\n  subgraph SYS[\&quot;System\&quot;]\n    S1([\&quot;Check ROOMS availability for requested period\&quot;])\n    S2{\&quot;Room available?\&quot;}\n    S3([\&quot;Show room is unavailable\&quot;])\n    S4([\&quot;BOOKINGS: status = REQUEST_PENDING\&quot;])\n    S5([\&quot;BOOKINGS: status = PAYMENT_PENDING\&quot;])\n    S6([\&quot;Show payment deadline, hold expiry, cancellation policy\&quot;])\n    S7([\&quot;BOOKINGS: status = CANCELED\&quot;])\n    S8([\&quot;BOOKINGS: status = REJECTED, rejectReason; notify Tenant\&quot;])\n    S9([\&quot;Create short-term hold (holdExpiresAt)\&quot;])\n    S10([\&quot;Verify payment result (gateway or reconciled by owner)\&quot;])\n    S11{\&quot;Payment failed and hold still valid?\&quot;}\n    S12{\&quot;Payment successful?\&quot;}\n    S13{\&quot;Hold still valid or room still available?\&quot;}\n    S14([\&quot;BOOKINGS: status = BOOKING_CONFIRM\&quot;])\n    S15([\&quot;ROOMS: status = Reserved\&quot;])\n    F1[\&quot; \&quot;]\n    S16([\&quot;Cancel overlapping APPOINTMENT\&quot;])\n    S17([\&quot;Notify Tenant and Owner\&quot;])\n    J1[\&quot; \&quot;]\n    S18([\&quot;BOOKINGS: status = PAYMENT_EXPIRED, refund = Processing\&quot;])\n    S19([\&quot;Notify Tenant about refund\&quot;])\n    S20([\&quot;BOOKINGS: status = PAYMENT_EXPIRED\&quot;])\n    S21([\&quot;Release hold\&quot;])\n  end\n\n  subgraph OWN[\&quot;Owner / Authorized Manager\&quot;]\n    O1([\&quot;Review booking request\&quot;])\n    O2{\&quot;Accept request?\&quot;}\n    O3([\&quot;Confirm move-in date, deposit amount, holding terms\&quot;])\n    O4([\&quot;Approve deposit refund\&quot;])\n  end\n\n  E1(((\&quot; \&quot;)))\n  E2(((\&quot; \&quot;)))\n  E3(((\&quot; \&quot;)))\n  E4(((\&quot; \&quot;)))\n  E5(((\&quot; \&quot;)))\n  E6(((\&quot; \&quot;)))\n\n  Start --&gt; T1 --&gt; T2 --&gt; S1 --&gt; S2\n  S2 --&gt;|\&quot;[no]\&quot;| S3 --&gt; E1\n  S2 --&gt;|\&quot;[yes]\&quot;| S4 --&gt; O1 --&gt; O2\n  O2 --&gt;|\&quot;[no]\&quot;| S8 --&gt; E2\n  O2 --&gt;|\&quot;[yes]\&quot;| O3 --&gt; S5 --&gt; S6 --&gt; T3 --&gt; T4\n  T4 --&gt;|\&quot;[no]\&quot;| S7 --&gt; E3\n  T4 --&gt;|\&quot;[yes]\&quot;| S9 --&gt; T5 --&gt; S10 --&gt; S11\n  S11 --&gt;|\&quot;[yes]\&quot;| T5\n  S11 --&gt;|\&quot;[no]\&quot;| S12\n  S12 --&gt;|\&quot;[no]\&quot;| S20 --&gt; S21 --&gt; E4\n  S12 --&gt;|\&quot;[yes]\&quot;| S13\n  S13 --&gt;|\&quot;[hold expired and room taken]\&quot;| O4 --&gt; S18 --&gt; S19 --&gt; E5\n  S13 --&gt;|\&quot;[yes]\&quot;| S14 --&gt; S15 --&gt; F1\n  F1 --&gt; S16 --&gt; J1\n  F1 --&gt; S17 --&gt; J1\n  J1 --&gt; T6 --&gt; E6\n\n  classDef bar fill:#000,stroke:#000,color:#000;\n  classDef initial fill:#000,stroke:#000;\n  classDef final fill:#fff,stroke:#000,stroke-width:3px;\n  class F1,J1 bar;\n  class Start initial;\n  class E1,E2,E3,E4,E5,E6 final;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="1G42JN2VWjjHyuUpRvLD-3">
