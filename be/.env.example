MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=RentalRoomManagement

# VNPay Sandbox Configuration
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Generate a random Base64 secret of at least 32 bytes; never commit the actual secret.
JWT_SECRET=
JWT_ISSUER=rental-room-management
JWT_AUDIENCE=rental-room-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_STRENGTH=12
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
EMAIL_VERIFICATION_TTL=24h
EMAIL_RESEND_COOLDOWN=60s

# Local Mailpit. Use provider credentials and AUTH/STARTTLS=true in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Local development only. Production must use HTTPS.
REQUIRE_HTTPS=false
FORWARD_HEADERS_STRATEGY=none
PUBLIC_API_DOCS=true

# Optional demo account seeding; disabled by default.
AUTH_SEED_ENABLED=false
AUTH_SEED_PASSWORD=


# Viewing automation (non-secret; milliseconds).
# VIEWING_AUTOMATION_ENABLED=true
# VIEWING_AUTOMATION_DELAY_MS=30000
# VIEWING_AUTOMATION_INITIAL_DELAY_MS=10000

# Service requests: LOCAL DEVELOPMENT ONLY until the contract module exposes active tenancies.
# When enabled, every tenant is treated as renting this room (slot optional) for service registration.
SERVICE_REQUEST_TENANCY_STUB_ENABLED=false
SERVICE_REQUEST_TENANCY_STUB_ROOM_ID=
SERVICE_REQUEST_TENANCY_STUB_ROOM_SLOT_ID=
