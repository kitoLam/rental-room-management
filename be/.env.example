MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=RentalRoomManagement

# HS512 signing key, >= 64 characters
JWT_SIGNER_KEY=change-me-to-a-random-string-of-at-least-64-characters-0123456789abcdef
# Token lifetimes in seconds
JWT_VALID_DURATION=3600
JWT_REFRESHABLE_DURATION=604800
